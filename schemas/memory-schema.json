{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://internal/smriti/memory-schema.json",
  "title": "ProjectMemoryState",
  "description": "Canonical structure for a project's persisted MEMORY.md state. Validated in-memory before every Phase 4 Persistence Handshake write, whether rendered to Markdown or synced to an MCP memory graph.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_name",
    "last_updated",
    "tier3_domain_rules",
    "tier2_architecture_log",
    "tier1_active_tasks",
    "compressed_changelog"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0.0"
    },
    "project_name": {
      "type": "string",
      "minLength": 1
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    },
    "tier3_domain_rules": {
      "type": "array",
      "description": "Tier 3 — non-negotiable domain rules and user preferences. Append-and-supersede only; never garbage-collected by volume pressure.",
      "items": {
        "type": "string",
        "minLength": 3
      },
      "uniqueItems": true
    },
    "tier2_architecture_log": {
      "type": "array",
      "description": "Tier 2 — architecture decisions and long-term constraints, recorded as ADRs.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "date", "decision", "rationale", "status"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ADR-[0-9]{3,}$"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "decision": {
            "type": "string",
            "minLength": 3
          },
          "rationale": {
            "type": "string",
            "minLength": 3
          },
          "status": {
            "type": "string",
            "enum": ["active", "superseded", "deprecated"]
          },
          "supersedes": {
            "type": ["string", "null"],
            "pattern": "^ADR-[0-9]{3,}$"
          }
        }
      }
    },
    "tier1_active_tasks": {
      "type": "array",
      "description": "Tier 1 — active execution state. High-volatility; heavily pruned each consolidation pass.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task", "status"],
        "properties": {
          "task": {
            "type": "string",
            "minLength": 3
          },
          "status": {
            "type": "string",
            "enum": ["todo", "in_progress", "blocked", "done"]
          },
          "blocked_reason": {
            "type": ["string", "null"]
          },
          "updated": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "compressed_changelog": {
      "type": "array",
      "description": "Rolling archive of collapsed Tier 1/Tier 2 history — 2-line-per-window summaries produced by workflows/consolidate-memory.md.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["range", "summary"],
        "properties": {
          "range": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2} to \\d{4}-\\d{2}-\\d{2}$"
          },
          "summary": {
            "type": "string",
            "minLength": 3,
            "maxLength": 240
          }
        }
      }
    }
  }
}
