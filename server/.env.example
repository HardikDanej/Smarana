# Copy this file to .env and fill in real values. Never commit .env itself.
#
# No auth token: claude.ai's Custom Connector dialog only supports OAuth or
# no auth, not a static bearer token, so this server relies on the tunnel
# URL itself being a secret. Never share that URL, and restart the tunnel
# (new random URL) if you think it leaked.

# Where project memory files are stored on disk. Defaults to server/data
# if unset.
SMRITI_DATA_ROOT=

# Bind address/port for the local server before tunneling.
SMRITI_HOST=127.0.0.1
SMRITI_PORT=8787

# Your current tunnel's public hostname, no scheme/path, e.g.
# random-words-here.trycloudflare.com
# Required for any request routed through the tunnel to be accepted —
# without it every tunneled request is rejected as a possible DNS-rebinding
# attack. Update this and restart the server whenever the tunnel URL changes
# (every restart, for the free trycloudflare.com quick tunnel).
SMRITI_PUBLIC_HOST=
