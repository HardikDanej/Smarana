# Copy this file to .env and fill in real values. Never commit .env itself.

# Where project memory files are stored on disk. Defaults to server/data
# if unset.
SMARANA_DATA_ROOT=

# Bind address/port for the local server before tunneling.
SMARANA_HOST=127.0.0.1
SMARANA_PORT=8787

# Your current tunnel's public hostname, no scheme/path, e.g.
# random-words-here.trycloudflare.com
# Required for any request routed through the tunnel to be accepted —
# without it every tunneled request is rejected as a possible DNS-rebinding
# attack. Update this and restart the server whenever the tunnel URL changes
# (every restart, for the free trycloudflare.com quick tunnel).
SMARANA_PUBLIC_HOST=

# A real login gate, generated once:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# When this AND SMARANA_PUBLIC_HOST are both set, the server runs a real
# (minimal) OAuth 2.1 authorization server (see oauth_provider.py) — the
# claude.ai Connector flow ends at this password, not just possession of
# the tunnel URL. Leave blank to run with no auth at all (not recommended
# once you're past initial testing).
SMARANA_LOGIN_PASSWORD=
